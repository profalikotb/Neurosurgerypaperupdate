# ───────── Supabase (Project Settings → API) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # public anon key (safe in browser; RLS blocks all table access)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SERVER ONLY — never prefix with NEXT_PUBLIC_

# Only these emails may sign in (comma-separated)
ALLOWED_EMAILS=alikotb@gmail.com

# ───────── AI (any OpenAI-compatible endpoint) ─────────
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4.1
# Optional cheaper model for translation / MCQ / chat titles
LLM_MODEL_FAST=gpt-4.1-mini

# Embeddings (semantic search). Leave EMBEDDING_API_KEY empty to run keyword-only search.
# Vector size is fixed at 512 in the database migration.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# ───────── Literature sources ─────────
NCBI_API_KEY=                 # optional, raises PubMed limit 3→10 req/s (free: ncbi.nlm.nih.gov/account)
CONTACT_EMAIL=alikotb@gmail.com  # required by Unpaywall / NCBI / Crossref polite pool

# ───────── Automation ─────────
CRON_SECRET=change-me-to-a-long-random-string   # used by Vercel Cron + GitHub Actions
INGEST_LOOKBACK_DAYS=30       # first run back-fill window
AUTO_SUMMARIZE_MIN_SCORE=60   # papers at/above this score with open full text are summarised automatically
AUTO_SUMMARIZE_DAILY_LIMIT=15 # cost guard

# ───────── Optional email digest (resend.com) ─────────
RESEND_API_KEY=
DIGEST_FROM=Neurosurgery Update <digest@yourdomain.com>
